# Optional update feature. When the URL is set for an operating domain, the Ed25519 key ID and public key are required. Checks run only when the user clicks the toolbar button.
VITE_CUTLINE_UPDATE_MANIFEST=https://updates.example.com/cutline/manifests/stable/windows-x86_64.json
VITE_CUTLINE_UPDATE_KEY_ID=ed25519-replace-after-signing
VITE_CUTLINE_UPDATE_PUBLIC_KEY=replace-with-base64-32-byte-ed25519-public-key
# The same public key must also be present in the Cargo build environment so native download/launch commands cannot trust a renderer-supplied key.
CUTLINE_UPDATE_PUBLIC_KEY=replace-with-base64-32-byte-ed25519-public-key
CUTLINE_UPDATE_SIGNER_SUBJECT=Cutline Studio
CUTLINE_UPDATE_APPLE_TEAM_ID=replace-with-10-character-apple-team-id

# Optional crash collection endpoint. Reports are sent only after explicit opt-in.
VITE_CUTLINE_CRASH_ENDPOINT=https://errors.example.com/api/cutline/crashes
# Embedded into reports and used by browser-mode update comparison. Desktop update checks read the signed app version directly.
VITE_CUTLINE_APP_VERSION=0.1.0
